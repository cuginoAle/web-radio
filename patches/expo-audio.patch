index 0000000000000000000000000000000000000000..3d16febb1a50b4ae99b82fee023bf57dad7389f0
--- /dev/null
+++ b/android/src/main/java/expo/modules/audio/SpectrumTap.kt
@@ -0,0 +1,124 @@
+package expo.modules.audio
+
+import android.content.Context
+import androidx.media3.common.C
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.DefaultRenderersFactory
+import androidx.media3.exoplayer.audio.AudioSink
+import androidx.media3.exoplayer.audio.DefaultAudioSink
+import androidx.media3.exoplayer.audio.ForwardingAudioSink
+import androidx.media3.exoplayer.audio.TeeAudioProcessor
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+
+private const val HOP = 2048 // one analysis every ~46 ms: about 21 a second
+private const val MAX_PENDING = 64 // ~3 s: past this the clock is not telling us anything, stop holding levels back
+
+/**
+ * Web Radio patch (docs/adr/0005): measures the Spectrum from the decoded audio on its way to the
+ * speaker, so no Visualizer and no RECORD_AUDIO. The audio reaches the tap before it is heard, so
+ * each analysis waits until the sink's clock reaches it.
+ */
+@UnstableApi
+class SpectrumTap : TeeAudioProcessor.AudioBufferSink {
+  @Volatile var enabled = false
+
+  /** Called on the playback thread with 20 levels, 0..1. */
+  var onBands: ((FloatArray) -> Unit)? = null
+
+  private val bands = SpectrumBands()
+  private val ring = FloatArray(SPECTRUM_WINDOW)
+  private val pending = ArrayDeque<Pair<Long, FloatArray>>() // media time (µs) the analysis is heard at
+  private var write = 0
+  private var sinceHop = 0
+  private var sampleRate = 44_100
+  private var channels = 2
+  private var encoding = C.ENCODING_PCM_16BIT
+  private var frames = 0L // since the last flush
+  private var startUs = C.TIME_UNSET
+  private var lastBufferUs = C.TIME_UNSET
+
+  fun renderersFactory(context: Context) = object : DefaultRenderersFactory(context) {
+    override fun buildAudioSink(context: Context, enableFloatOutput: Boolean, enableAudioTrackPlaybackParams: Boolean): AudioSink {
+      val sink = DefaultAudioSink.Builder(context)
+        .setEnableFloatOutput(enableFloatOutput)
+        .setEnableAudioOutputPlaybackParameters(enableAudioTrackPlaybackParams)
+        .setAudioProcessors(arrayOf(TeeAudioProcessor(this@SpectrumTap)))
+        .build()
+      return object : ForwardingAudioSink(sink) {
+        override fun handleBuffer(buffer: ByteBuffer, presentationTimeUs: Long, encodedAccessUnitCount: Int): Boolean {
+          lastBufferUs = presentationTimeUs
+          val handled = super.handleBuffer(buffer, presentationTimeUs, encodedAccessUnitCount)
+          release(getCurrentPositionUs(false))
+          return handled
+        }
+
+        override fun flush() {
+          super.flush()
+          restart()
+        }
+      }
+    }
+  }
+
+  override fun flush(sampleRateHz: Int, channelCount: Int, encoding: Int) {
+    sampleRate = sampleRateHz
+    channels = channelCount
+    this.encoding = encoding
+    restart()
+  }
+
+  override fun handleBuffer(buffer: ByteBuffer) {
+    val sampleBytes = when (encoding) {
+      C.ENCODING_PCM_16BIT -> 2
+      C.ENCODING_PCM_FLOAT -> 4
+      else -> return // other formats leave the bars flat
+    }
+    val count = buffer.remaining() / (sampleBytes * channels)
+    if (startUs == C.TIME_UNSET) startUs = lastBufferUs
+    if (!enabled) {
+      frames += count
+      pending.clear()
+      bands.reset()
+      return
+    }
+    val data = buffer.order(ByteOrder.nativeOrder())
+    var at = buffer.position()
+    repeat(count) {
+      var sum = 0f
+      repeat(channels) {
+        sum += if (sampleBytes == 2) data.getShort(at) / 32768f else data.getFloat(at)
+        at += sampleBytes
+      }
+      ring[write] = sum / channels
+      write = (write + 1) % SPECTRUM_WINDOW
+      frames++
+      if (++sinceHop == HOP) {
+        sinceHop = 0
+        analyse()
+      }
+    }
+  }
+
+  private fun analyse() {
+    // The window's centre is what the levels describe.
+    val heardAtUs = startUs + (frames - SPECTRUM_WINDOW / 2) * 1_000_000L / sampleRate
+    pending.addLast(heardAtUs to bands.analyse(ring, write, sampleRate))
+    if (pending.size > MAX_PENDING) onBands?.invoke(pending.removeFirst().second)
+  }
+
+  private fun release(positionUs: Long) {
+    var latest: FloatArray? = null
+    while (pending.isNotEmpty() && pending.first().first <= positionUs) latest = pending.removeFirst().second
+    latest?.let { onBands?.invoke(it) }
+  }
+
+  private fun restart() {
+    frames = 0
+    startUs = C.TIME_UNSET
+    sinceHop = 0
+    pending.clear()
+    ring.fill(0f)
+    bands.reset()
+  }
+}
