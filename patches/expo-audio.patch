diff --git a/android/src/main/java/expo/modules/audio/SpectrumBands.kt b/android/src/main/java/expo/modules/audio/SpectrumBands.kt
new file mode 100644
index 0000000000000000000000000000000000000000..da4c71123560a59d1c191c837a6dfdbe413a948e
--- /dev/null
+++ b/android/src/main/java/expo/modules/audio/SpectrumBands.kt
@@ -0,0 +1,92 @@
+package expo.modules.audio
+
+import kotlin.math.PI
+import kotlin.math.ceil
+import kotlin.math.cos
+import kotlin.math.log10
+import kotlin.math.max
+import kotlin.math.pow
+import kotlin.math.sin
+
+// Web Radio patch (docs/adr/0005): the band maths of the Spectrum. Pure Kotlin, no Android types.
+
+internal const val SPECTRUM_WINDOW = 4096 // ~11 Hz bins at 44.1 kHz: the lowest bands stay distinct
+private const val BANDS = 20
+private const val MIN_HZ = 40.0
+private const val MAX_HZ = 16_000.0
+private const val FLOOR_DB = -60.0
+private const val CEILING_DB = -10.0
+private const val FALL_PER_FRAME = 0.08f // fast rise, slow fall
+private const val FULL_SCALE = (SPECTRUM_WINDOW / 4.0) * (SPECTRUM_WINDOW / 4.0) // peak bin power of a full-scale sine
+
+internal class SpectrumBands {
+  private val hann = FloatArray(SPECTRUM_WINDOW) { (0.5 - 0.5 * cos(2 * PI * it / (SPECTRUM_WINDOW - 1))).toFloat() }
+  private val edges = DoubleArray(BANDS + 1) { MIN_HZ * (MAX_HZ / MIN_HZ).pow(it.toDouble() / BANDS) }
+  private val re = FloatArray(SPECTRUM_WINDOW)
+  private val im = FloatArray(SPECTRUM_WINDOW)
+  private val shown = FloatArray(BANDS)
+
+  fun reset() = shown.fill(0f)
+
+  /** Levels 0..1 of the last SPECTRUM_WINDOW mono samples; `ring[start]` is the oldest one. */
+  fun analyse(ring: FloatArray, start: Int, sampleRate: Int): FloatArray {
+    for (i in 0 until SPECTRUM_WINDOW) {
+      re[i] = ring[(start + i) % SPECTRUM_WINDOW] * hann[i]
+      im[i] = 0f
+    }
+    fft(re, im)
+    val binHz = sampleRate.toDouble() / SPECTRUM_WINDOW
+    for (band in 0 until BANDS) {
+      // A bin belongs to the band its centre frequency falls in.
+      val from = ceil(edges[band] / binHz).toInt()
+      val to = max(from + 1, ceil(edges[band + 1] / binHz).toInt()).coerceAtMost(SPECTRUM_WINDOW / 2)
+      var power = 0.0
+      for (bin in from until to) power += re[bin] * re[bin] + im[bin] * im[bin]
+      val db = 10 * log10(power / FULL_SCALE + 1e-12)
+      val level = ((db - FLOOR_DB) / (CEILING_DB - FLOOR_DB)).coerceIn(0.0, 1.0).toFloat()
+      shown[band] = max(level, shown[band] - FALL_PER_FRAME)
+    }
+    return shown.copyOf()
+  }
+
+  // In-place iterative radix-2 FFT.
+  private fun fft(re: FloatArray, im: FloatArray) {
+    val n = re.size
+    var j = 0
+    for (i in 1 until n) {
+      var bit = n shr 1
+      while (j and bit != 0) {
+        j = j xor bit
+        bit = bit shr 1
+      }
+      j = j xor bit
+      if (i < j) {
+        re[i] = re[j].also { re[j] = re[i] }
+        im[i] = im[j].also { im[j] = im[i] }
+      }
+    }
+    var len = 2
+    while (len <= n) {
+      val stepRe = cos(-2 * PI / len).toFloat()
+      val stepIm = sin(-2 * PI / len).toFloat()
+      for (i in 0 until n step len) {
+        var wRe = 1f
+        var wIm = 0f
+        for (k in 0 until len / 2) {
+          val a = i + k
+          val b = a + len / 2
+          val tRe = re[b] * wRe - im[b] * wIm
+          val tIm = re[b] * wIm + im[b] * wRe
+          re[b] = re[a] - tRe
+          im[b] = im[a] - tIm
+          re[a] += tRe
+          im[a] += tIm
+          val next = wRe * stepRe - wIm * stepIm
+          wIm = wRe * stepIm + wIm * stepRe
+          wRe = next
+        }
+      }
+      len = len shl 1
+    }
+  }
+}
